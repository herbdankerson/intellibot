{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["x-version", "servers"],
  "properties": {
    "x-version": {"type": "string"},
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "tools"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "token_env": {"type": "string"},
          "tools": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
