{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["x-version", "models", "router"],
  "properties": {
    "x-version": {"type": "string"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "model"],
        "properties": {
          "name": {"type": "string"},
          "model": {"type": "string"},
          "params": {"type": "object"}
        }
      }
    },
    "router": {
      "type": "object",
      "properties": {
        "default": {"type": "string"}
      },
      "required": ["default"]
    }
  }
}
